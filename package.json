{
  "name": "playwright-course.jm-consultant", 
  "version": "1.0.0",
  "description": "Un proyecto de Playwright para pruebas automatizadas",
  "main": "index.js",
  "scripts": {
    "validate": "npm run typecheck && npm run lint",
    "test": "npm run validate && playwright test",
    "test:headed": "npm run validate && playwright test --headed",
    "lint": "eslint tests/ models/ pages/ helpers/ fixtures/ playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test:report": "npx playwright show-report",
    "prepare": "npx playwright install --with-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "dotenv": "^17.4.2",
    "path": "^0.12.7"
  }
}
